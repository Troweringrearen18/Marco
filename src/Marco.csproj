<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Imprescindible: sin PerMonitorV2, con escalado 125/150% las coordenadas
         del monitor llegan virtualizadas y la ventana no cubre la pantalla -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Icono del exe (Explorer/barra de tareas); regenerable con el script de scratchpad -->
    <ApplicationIcon>icono.ico</ApplicationIcon>
    <!-- Fuente única de la versión: la UI la lee de Application.ProductVersion -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- El publish deja Marco.exe en la raíz del repo (está en .gitignore), no enterrado
       en bin\Release\...\publish; sin .pdb, que no se distribuye -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishDir>..\</PublishDir>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
